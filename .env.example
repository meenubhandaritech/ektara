# ============ BACKEND (backend/.env) — SERVER-SIDE SECRETS ONLY ============
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Set to "true" to run without Firebase/Gemini using synthetic sample data.
# DEMO MODE is clearly labelled in the UI and never touches production data.
DEMO_MODE=true

# Firebase Admin SDK (server only — never expose these to the frontend).
# Use either a service-account pair below or Application Default Credentials
# (GOOGLE_APPLICATION_CREDENTIALS / gcloud ADC / a Google Cloud runtime identity).
FIREBASE_PROJECT_ID=ektara-507fd
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini (server only). If empty, the assistant uses curated-FAQ retrieval fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============ FRONTEND (frontend/.env) — PUBLIC CLIENT CONFIG ONLY ============
# Firebase web config values are public identifiers, not secrets.
VITE_API_BASE_URL=http://localhost:8080
VITE_DEMO_MODE=true
# Firebase web config values are public client identifiers. These are not credentials
# for the backend and do not replace Authentication or Firestore Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
